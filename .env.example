# Existing Supabase values remain required during the controlled migration.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Development Worker. Leave blank to use Supabase only.
VITE_CVD_API_URL=""

# supabase: current production behavior
# compare: display Supabase and compare it with Worker results in diagnostics
# worker: display Worker results, falling back to the last local cache on failure
VITE_CVD_API_READ_MODE="supabase"

# Keep false until account UI and development write smoke tests pass.
VITE_CVD_API_WRITES_ENABLED="false"
VITE_CVD_APP_VERSION="1.1.0"
